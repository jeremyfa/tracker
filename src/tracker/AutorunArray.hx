package tracker;

using tracker.Extensions;

/**
 * The autoruns bound to an observable field (the `<field>Autoruns` field
 * generated by `@observe`), in the order they bound to it.
 *
 * Internal to tracker. Binding and unbinding cost O(1):
 *
 * - each binding knows its slot here (`Autorun` keeps the slot of each of
 *   its bindings) and each slot knows the index of its binding in the
 *   autorun's list (`bindingIndices`), so an autorun unbinds by writing
 *   `null` into its slot, without searching;
 * - an autorun binds by appending itself at the end; the slots left `null`
 *   are removed (keeping the order of the others) when they are more than
 *   half of the array, on the next bind, which moves each remaining binding
 *   once and updates the slot the autorun remembers;
 * - `lastBinder` is the autorun that bound last, as long as it stays bound:
 *   reading the field again from that autorun is found bound at once.
 *
 * The autoruns are invalidated in the order they bound (the oldest binding
 * first), as when the array was a plain `Array<Autorun>`.
 */
@:allow(tracker.Autorun)
@:allow(tracker.AutorunBindings)
class AutorunArray {

    static var nextId:Int = 0;

    /**
     * Unique id of this array, its key in the binding sets of the autoruns
     * (`AutorunBindings`). Recycled arrays keep their id.
     */
    final id:Int;

    /** Bound autoruns, oldest first. `null` where an autorun unbound. */
    final autoruns:Array<Autorun> = [];

    /** For each slot, the index of the binding in the autorun's `AutorunBindings` */
    final bindingIndices:Array<Int> = [];

    /** Number of `null` slots in `autoruns` */
    var holes:Int = 0;

    /** The autorun that bound last, while it is still bound (else `null`) */
    var lastBinder:Autorun = null;

    public function new() {

        id = nextId++;

    }

    /** Number of slots, `null` ones included */
    public var length(get, never):Int;
    inline function get_length():Int {
        return autoruns.length;
    }

    /** The autorun in the given slot (`null` if it unbound) */
    inline public function get(index:Int):Autorun {
        return autoruns.unsafeGet(index);
    }

    /**
     * Appends `autorun`, whose binding index is `bindingIndex`, and returns its slot.
     * Removes the `null` slots first when they are more than half of the array.
     */
    function add(autorun:Autorun, bindingIndex:Int):Int {

        var len = autoruns.length;
        if (holes > 0 && holes * 2 > len) {
            compact();
            len = autoruns.length;
        }

        autoruns.push(autorun);
        bindingIndices.push(bindingIndex);
        return len;

    }

    /** Clears the slot of an unbinding autorun */
    inline function remove(autorun:Autorun, slot:Int):Void {

        // The check keeps a stale slot (there should be none) from
        // clearing another autorun's binding
        if (slot < autoruns.length && autoruns.unsafeGet(slot) == autorun) {
            autoruns.unsafeSet(slot, null);
            holes++;
        }
        if (lastBinder == autorun) {
            lastBinder = null;
        }

    }

    /** Removes the `null` slots, keeping the order, and tells each moved autorun its new slot */
    function compact():Void {

        var len = autoruns.length;
        var j = 0;
        for (i in 0...len) {
            var autorun = autoruns.unsafeGet(i);
            if (autorun != null) {
                if (i != j) {
                    var bindingIndex = bindingIndices.unsafeGet(i);
                    autoruns.unsafeSet(j, autorun);
                    bindingIndices.unsafeSet(j, bindingIndex);
                    @:privateAccess autorun.bindings.slots.unsafeSet(bindingIndex, j);
                }
                j++;
            }
        }

        truncate(autoruns, j);
        truncate(bindingIndices, j);
        holes = 0;

    }

    /** Empties the array before it goes back to the pool */
    function clear():Void {

        truncate(autoruns, 0);
        truncate(bindingIndices, 0);
        holes = 0;
        lastBinder = null;

    }

    static inline function truncate<T>(array:Array<T>, length:Int):Void {

        #if cpp
        untyped array.__SetSize(length);
        #else
        array.resize(length);
        #end

    }

}
